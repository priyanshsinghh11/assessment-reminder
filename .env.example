# Automated runs. Off by default: nothing scrapes the portal or emails a
# candidate unless a person asks for it (the dashboard's Sync portal button, or
# manage.py reminder --force). Set to 1 to let the cron job send again.
AUTOMATION_ENABLED=0

# ---------------------------------------------------------------------------
# Deployment -- only read by wsgi.py, i.e. only when gunicorn is serving
# ---------------------------------------------------------------------------
#
# `python manage.py serve` takes its mode from flags and ignores both of these. They
# exist because a container has nowhere to type a flag.
#
# REVIEW_ONLY  the same split `manage.py serve --review-only` makes, as an env var.
#              0 (default) is the full dashboard: every role, every candidate's
#              address, every send button. It belongs somewhere private.
#              1 serves ONLY the manager review surface -- /review/<token>, its
#              API, and the few files those pages are built from. Everything
#              else 404s. THIS is the process that may face the internet.
#
#              Run one of each. PUBLIC_BASE_URL points at the review process
#              and DASHBOARD_BASE_URL at the dashboard one; once they are split
#              those are different hostnames, and the review server does not
#              serve evaluations.html.
#
# PORT         what gunicorn binds. Cloud Run, App Service and Heroku all set
#              this themselves; leave it unset there.
#
# A NOTE ON BINDING. `manage.py serve` defaults to 127.0.0.1 because a flag is a thing
# a person types. In a container there is no loopback worth binding to, so
# gunicorn binds 0.0.0.0 and the boundary moves outward to the platform. Put
# TLS in front of it and set SESSION_COOKIE_SECURE=1 when you do.
# REVIEW_ONLY=0
# PORT=8080

# ---------------------------------------------------------------------------
# Dashboard accounts -- who can sign in, and which roles they see
# ---------------------------------------------------------------------------
#
# Two kinds of account, and the difference is enforced by the server on every
# request, not by hiding buttons:
#
#   admin     the recruiting team. Every role, plus the machinery: portal
#             sync, reminder sends, who owns which seat, and the accounts.
#   manager   a hiring manager. ONLY the roles whose hiring-manager list
#             carries their address. Every other role answers 404 -- the same
#             answer a job id that never existed gets -- and their roles grid
#             never mentions it.
#
# WHICH ROLES A MANAGER SEES IS NOT CONFIGURED ANYWHERE. It is the
# "Hiring managers" list on each role in the dashboard -- the same list the
# shortlist email goes to. Add somebody there and they can open that role;
# remove them and they cannot, in the same click. One place to say who owns a
# seat is what stops access from drifting away from ownership.
#
# FIRST RUN
#   1. python manage.py users add you@ajaia.ai --admin
#   2. python manage.py serve, open http://127.0.0.1:5000, sign in with the password
#      it printed, and set your own when it asks.
#   3. Create the rest from the Accounts panel on the evaluations page.
#
# PORTAL_ADMINS / PORTAL_ADMIN_PASSWORD do the same thing from .env instead --
# every address listed is created as an admin at startup if it does not already
# exist, with that password, and is asked to change it at first sign-in. An
# address that already exists is left alone, so this never resets a password or
# re-promotes an account somebody deliberately demoted. Clear
# PORTAL_ADMIN_PASSWORD once the first admin is in; a password in a .env file
# is a password on disk.
# PORTAL_ADMINS=you@ajaia.ai,someone@ajaia.ai
# PORTAL_ADMIN_PASSWORD=

# AUTH_ENABLED   the only way to turn all of this off, and it defaults to on.
#                Set to 0 ONLY on a local machine with no real data: it
#                restores the old everybody-sees-everything dashboard, and the
#                server logs a warning saying so on every start.
# AUTH_ENABLED=1

# MANAGER_DASHBOARD_SCORES  on by default. Whether a signed-in hiring manager
#                reads the AI score on the DASHBOARD -- the number, the grid
#                behind it, the verdict and the brief.
#                THIS IS THE ONLY SURFACE IT COVERS. The shortlist email still
#                obeys SHORTLIST_SHOW_SCORES below, the spreadsheet still obeys
#                the recruiting team's per-send tick, and the review link --
#                the one page with no sign-in -- still never carries a score.
#                The dashboard is different from all three: the reader is
#                signed in, they are named on the role, and the number opens
#                into the grid and the anchors that produced it. A "78" you can
#                open and argue with is not the same thing as a "78" in an
#                inbox with nothing behind it.
#                Set to 0 to put their screen back to rank and the work only.
# MANAGER_DASHBOARD_SCORES=1

# How long a sign-in lasts. Two clocks, and the shorter one wins: TTL is the
# absolute age of the session however active it has been, IDLE is time since
# its last request, so a dashboard left open on an unlocked laptop stops being
# a way in overnight.
# SESSION_TTL_HOURS=12
# SESSION_IDLE_HOURS=8

# The session cookie. Secure is inferred from DASHBOARD_BASE_URL starting with
# https, because a cookie marked Secure is simply never sent over the
# plain-HTTP loopback dev server -- which looks exactly like a sign-in that
# does not work. Force it on when TLS is terminated by a proxy this process
# cannot see.
# SESSION_COOKIE=ajaia_session
# SESSION_COOKIE_SECURE=0

# Failed-sign-in lockout, per account rather than per address doing the
# guessing -- a distributed attempt is the one worth stopping. Short enough
# that it makes guessing slow rather than locking a manager out of their own
# shortlist.
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_LOCKOUT_MINUTES=15

# ...and a throttle on the source of the attempts, which the lockout above is
# not and cannot be. On its own, a per-account lockout hands anyone who knows
# an admin's address a way to keep them signed out for ever: eight wrong
# passwords locks them for fifteen minutes, and eight more does it again, from
# anywhere, at no cost.
#
# LOGIN_IP_MAX_ATTEMPTS MUST STAY BELOW LOGIN_MAX_ATTEMPTS. That is the whole
# mechanism: a single source runs out of attempts before the account runs out
# of tolerance, so the flood is absorbed instead of being converted into a
# lockout. Attempts refused by the throttle never reach the account and never
# count toward locking it. The server warns at startup if this ordering is
# broken, and CI fails the build.
# LOGIN_IP_MAX_ATTEMPTS=5
# LOGIN_IP_WINDOW_MINUTES=15

# How many reverse proxies stand in front of this process.
#
# X-Forwarded-For is written by the CLIENT. Trusting it blindly makes the
# throttle above useless -- a new forged address per request is a fresh bucket
# every time. Each proxy appends the peer it saw, so with a known hop count the
# real client is that many entries from the right.
#
# 0 (default) ignores the header and uses the socket's peer address, which is
# correct when nothing is in front of this. Set it to the number of proxies you
# actually run: 1 behind a single nginx or Cloud Run, 2 behind a CDN as well.
# Too HIGH is the dangerous direction -- it reaches into the part of the header
# the client controls.
# TRUSTED_PROXY_HOPS=0

# Shortest password accepted when one is set or changed. Length rather than a
# character-class rule: a rule demanding a symbol is how "Password1!" happens.
# PASSWORD_MIN_LENGTH=12

# Workable API (generate at Settings > Integrations > API in Workable)
WORKABLE_API_TOKEN=your_workable_api_token

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key

# Assessment portal login (for scraping candidate statuses)
PORTAL_EMAIL=your_portal_login_email
PORTAL_PASSWORD=your_portal_password

# MongoDB (stores submissions, assessments and AI evaluations)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=assessment-evaluation

# AI evaluation. Any OpenAI-compatible /chat/completions endpoint works --
# Groq, Together, OpenRouter, or a local server. Ingest and the dashboard run
# fine without these; only grading is blocked.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
# Raise only if your provider's rate limit allows it; free tiers usually do not.
LLM_CONCURRENCY=1

# How the assessment and the CV split the final score. Both are marked out of
# 100; the split is per seat, in config.CV_WEIGHT_BY_SEAT -- 25% CV on a
# full-stack build, 60% on Customer Success and Investments. These two only
# override that table.
#
# CV_SCORE_WEIGHT   the CV's share for a seat the table does not name (0.50).
# CV_WEIGHT_OVERRIDE  one weight for every seat, ignoring the table. Set it to
#                   0.5 to reproduce the old flat split, or to revert in one
#                   line. Leave unset in normal operation.
# CV_MISSING_POLICY  what happens when a CV cannot be read, which is 38% of
#                   candidates and always our extraction's fault, not theirs.
#                   "forfeit" takes the CV's share away, capping them at
#                   (1-w)x100 -- 40 on the heaviest seats. "rescale" scores
#                   them on the assessment alone and is recommended.
# CV_SCORE_WEIGHT=0.50
# CV_WEIGHT_OVERRIDE=
# CV_MISSING_POLICY=forfeit

# What the candidate hears when a manager moves them on the board. Two mails,
# both to the candidate: the interview invitation, which carries the manager's
# own cal.com link, and the rejection after a human has read them. Nothing is
# sent for a hire -- an offer is a conversation someone has, not a template a
# board click fires.
#
# The booking link itself is NOT configured here. It belongs to the manager,
# who pastes it into the dashboard once, and it is stored on them in Mongo.
#
# PIPELINE_EMAILS_ENABLED   set to 0 to record every move silently. The board
#                           still works; nothing reaches a candidate.
# CANDIDATE_REPLY_TO        where a candidate's reply lands when we do not know
#                           which manager owns the meeting. Defaults to the
#                           sender, which is a person. Never a no-reply box --
#                           "I cannot make any of those times" needs somewhere
#                           to go, and so does "may I ask what let me down".
# INTERVIEW_BOOK_WITHIN_DAYS  copy only, in the nudge to book. Nothing expires.
# PIPELINE_EMAILS_ENABLED=1
# CANDIDATE_REPLY_TO=
# INTERVIEW_BOOK_WITHIN_DAYS=5

# The hand-off to the hiring manager. Managers themselves are assigned per role
# in the dashboard and stored in Mongo, not here -- they change with every
# reorg, and a config edit plus a restart is the wrong ceremony for that.
#
# SHORTLIST_SIZE   how many candidates go in one hand-off (20).
# SHORTLIST_MAX    hard ceiling on a single send, so a typo in the size box
#                  cannot mail a manager four thousand rows (100).
# SHORTLIST_SHOW_SCORES  off by default, and flipping it is a policy change.
#                  The manager sees rank, name, contact and links to the CV and
#                  the answers -- never the score, the band or the verdict. An
#                  AI number beside a person's name decides the interview
#                  before the manager has read a word of the work.
#                  THIS IS THE DEFAULT, NOT THE WHOLE ANSWER: the dashboard's
#                  Shortlist tab has an "AI score" tick the recruiting team
#                  sets per send, and this value is where that box starts.
#                  Ticked, the number goes in the SPREADSHEET only -- the
#                  attachment and the Download Excel button are the same file
#                  -- and never in the email body or the manager's review page.
#                  A hiring-manager account cannot tick it or ask for it.
# SHORTLIST_REQUIRE_COMPLETE_GRID  on by default. A verdict whose rubric the
#                  AI did not finish is renormalised to 100 by the scorer, so
#                  it does not sort low -- it sorts to the TOP, and the manager
#                  sees rank with no score to read it against. Those verdicts
#                  are held out of the ranking and reported to the recruiter as
#                  a re-grade list instead. Turning this off ranks them anyway;
#                  they are labelled "partly graded" everywhere if you do.
# SHORTLIST_SIZE=20
# SHORTLIST_MAX=100
# SHORTLIST_SHOW_SCORES=false
# SHORTLIST_REQUIRE_COMPLETE_GRID=true

# What counts as a graded submission at all.
#
# GRID_MIN_COVERAGE  the fraction of the rubric's WEIGHT that must actually be
#                  marked for a verdict to be stored (0.5). Under it the
#                  verdict is refused and the submission stays ungraded for the
#                  next run to pick up. This is not a quality bar -- it is the
#                  line under which renormalising is arithmetic on nothing: one
#                  row marked 5 out of seven renormalises to exactly 100.0,
#                  which is indistinguishable from a flawless full grid.
#
#                  Partial grids mean the JSON ran past LLM_MAX_OUTPUT_TOKENS,
#                  so the real fix is raising that rather than this. Watch for
#                  "Verdict rated N of M criteria" in the grading log.
# GRID_MIN_COVERAGE=0.5

# Where hiring managers reach the review page. The link in their shortlist
# email is built from this, so the default -- 127.0.0.1 -- produces links that
# work on the machine that sent them and nowhere else. The dashboard says so
# before and after a send rather than letting you find out when nobody replies.
#
# EXPOSING THIS STILL WANTS A SECOND PROCESS. The dashboard now asks for a
# sign-in, but review links do not -- the token in the URL is the credential,
# and the review server has no accounts behind it. Run
#     python manage.py serve                                    # dashboard, loopback
#     python manage.py serve --review-only --host 0.0.0.0 --port 5051
# and point PUBLIC_BASE_URL at the second one, behind TLS. Plain HTTP hands
# that token, and any session cookie, to the network.
# PUBLIC_BASE_URL=https://hire.example.com

# Where the recruiter dashboard answers. The shortlist email links the manager
# straight to the role's shortlist tab with it:
#     <DASHBOARD_BASE_URL>/evaluations.html#role=33&tab=shortlist
# Defaults to PUBLIC_BASE_URL, which is right while one process serves both and
# wrong once the review server is split out per the note above -- the dashboard
# is not on the review-only allowlist, so that link 404s there.
#
# Safe to send now: the dashboard asks the manager to sign in, and what they
# see once they do is only the roles they are listed on. It still has to be an
# address they can actually reach -- the review-only server does not serve
# evaluations.html, so this must point at the dashboard process, on a host the
# manager can open and behind TLS if that is anywhere but the office network.
# Switch the link off below if you would rather send nothing but review links.
# DASHBOARD_BASE_URL=http://127.0.0.1:5000

# The Ajaia wordmark at the top of every candidate and manager email. A mail
# client cannot read a file off this disk, so it has to be an absolute URL the
# recipient's machine can fetch.
#
# LEAVE THIS ALONE AND IT LOOKS AFTER ITSELF. The mark is checked in at
# frontend/assets/ajaia-logo-white.png and served at /assets/, so the default
#     <PUBLIC_BASE_URL>/assets/ajaia-logo-white.png
# is already right -- including under --review-only, where both logo files are
# on the allowlist by name. Setting PUBLIC_BASE_URL is the only step.
#
# Override it only to serve the mark from somewhere else entirely, such as the
# marketing site or a CDN. Whatever you point it at has to actually serve that
# file: this is not a path into frontend/assets/, it is the whole URL.
# EMAIL_LOGO_URL=https://cdn.example.com/ajaia-logo-white.png

# Whether the shortlist email carries that dashboard link at all. On by
# default. Set to 0 to send managers nothing but their private review link.
# SHORTLIST_DASHBOARD_LINK=1

# How long a manager's review link stays live. A fresh send mints a fresh
# link, so this is not a deadline on the hiring.
# REVIEW_LINK_DAYS=30

# Candidate outcome emails, sent when a manager moves someone on the board.
# `interview` carries the manager's booking link; `rejected` is the considered
# turn-down. Nothing is ever sent for `hired`.
# PIPELINE_EMAILS_ENABLED=1
# CANDIDATE_REPLY_TO=
# INTERVIEW_BOOK_WITHIN_DAYS=5

# ---------------------------------------------------------------------------
# Bulk rejections
# ---------------------------------------------------------------------------
#
# The Rejections page mails everyone who did not make it -- typically several
# hundred a round, most of them turned down at the CV screen before they ever
# sat an assessment. One personalised message each, never a BCC.
#
# The record of who has been told lives in MongoDB (the `rejections`
# collection), not here, and it is what stops a second rejection reaching
# somebody who already had one. Both surfaces read it: the bulk send and the
# board's own rejection.
#
# REJECTION_SEND_DELAY   seconds between messages (0.35). Brevo tolerates far
#                        more, but a five-hundred-message burst from a domain
#                        that normally sends thirty a day is the shape a spam
#                        filter watches for. At the default a full round takes
#                        about three minutes.
# REJECTION_MAX_PER_SEND the blast radius of one click (600). A paste that
#                        accidentally carried the whole candidate export is
#                        refused rather than sent. Raise it deliberately.
# REJECTION_ABORT_AFTER  consecutive failures that stop a run (20). One bounce
#                        is a bad address and the batch carries on; twenty in a
#                        row is the API key or the network, and grinding
#                        through another four hundred helps nobody.
# REJECTION_SEND_DELAY=0.35
# REJECTION_MAX_PER_SEND=600
# REJECTION_ABORT_AFTER=20

# ---------------------------------------------------------------------------
# Candidate opt-outs
# ---------------------------------------------------------------------------
#
# Reminder emails carry a List-Unsubscribe header, which is what Gmail, Yahoo
# and Outlook read to decide whether we are a sender worth delivering. Bulk
# mail without one is scored down, and a few hundred near-identical reminders
# is the most bulk-shaped thing this system does.
#
# The one-click https link is only offered when PUBLIC_BASE_URL is https --
# a one-click endpoint on plain http is an unsubscribe anyone on the path can
# forge, and a loopback URL produces a link that opens on nobody's machine but
# ours. Until then the mailto below is the only way out a candidate has, so on
# the current default configuration it is the setting that matters.
#
# UNSUBSCRIBE_MAILTO   the address on the header, and the fallback in the
#                      footer. IT HAS TO BE A MAILBOX SOMEBODY READS -- mail
#                      sent there and ignored is worse than no header at all.
#                      Defaults to CANDIDATE_REPLY_TO, which is a person.
# UNSUBSCRIBE_MAILTO=jobs@ajaia.ai
#
# Opting out stops REMINDERS AND REJECTIONS. It does not stop an interview
# invitation: that is a transactional message about a meeting the candidate is
# being offered, and withholding it because they once opted out of a nudge
# would cost them the interview. The unsubscribe page says so.
#
# A rejection is on the other side of that line because it is bulk-shaped --
# the same words to everyone who did not make it -- so it carries the header,
# it carries a visible unsubscribe link, and it is skipped for anyone on this
# list. That applies to the board's own rejection and to the bulk send below.
#
# APP_SECRET   signs the unsubscribe links. Left unset, one is minted into
#              MongoDB on first start and reused for ever, which is what keeps
#              the link in an email sent last month working today. Set it here
#              only if you would rather hold the key yourself; CHANGING IT
#              INVALIDATES EVERY UNSUBSCRIBE LINK ALREADY SENT.
# APP_SECRET=

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
#
# logs/reminder.log names candidates and their email addresses line by line --
# deliberately, because the dashboard's Logs panel is how a recruiter follows
# what a run did. That also makes it a growing plaintext register of everyone
# who has ever applied, so it rotates: the live file stays readable and the
# oldest addresses fall off the end instead of accumulating for ever.
#
# THESE TWO NUMBERS ARE THE RETENTION POLICY. 5 MB x 5 is roughly a year at the
# current send rate. Change them when you have decided a retention period, not
# to make a warning go away.
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5
