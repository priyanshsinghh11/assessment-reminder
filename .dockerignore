# Secrets. The image is a thing that gets pushed to a registry and pulled by
# anyone with read access to it; a baked-in .env is a credential leak with a
# long tail. Pass them at runtime (--env-file, or the platform's secret store).
.env
.env.*
!.env.example
*.bak

# Candidate PII. Portal exports are regenerated by every ingest and have no
# business in a layer.
*.csv

# Runtime state, mounted as a volume rather than shipped. Copying a developer's
# reminder log into the image would seed production with the wrong idea of who
# has already been emailed.
state/
logs/

# A Windows/macOS virtualenv is both large and wrong for a Linux image.
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

.git/
.github/
.gitignore
.dockerignore
Dockerfile
docker-compose*.yml

# Notes and audits, not runtime. Rooted with a leading slash so it means "the
# markdown at the top of the repo" and nothing else -- assessments/ is 56
# markdown files that ARE runtime data, and the grids are derived from them.
/*.md

.DS_Store
.vscode/
.idea/
